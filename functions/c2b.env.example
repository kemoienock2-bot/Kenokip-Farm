# Copy this to c2b.env for the local registerC2BUrls.js / test-b2c.js /
# test-balance.js scripts ONLY.
# Never commit the real c2b.env file — it's already git-ignored.
#
# The deployed Cloud Functions themselves read the equivalent values as
# Secret Manager secrets, set with `firebase functions:secrets:set NAME`
# (see SETUP-MPESA.md and SETUP-B2C.md), not from this file — this file
# just lets the local scripts in this folder run without redeploying.
#
# Deliberately NOT named ".env" — Firebase's own `firebase deploy` auto-loads
# any file named exactly ".env" (or ".env.<project-id>") in this folder as
# real Cloud Functions environment variables, which then collides with the
# secrets of the same name and breaks deployment. Keep it as "c2b.env".
#
# Kenokip Farm uses TWO separate M-Pesa accounts: a Till for receiving
# deposits/collections, and a Paybill (1307475) for sending payouts. These
# are two different Safaricom shortcodes with their own separate API
# credentials each — Safaricom doesn't let one shortcode's credentials act
# on another's behalf. The two sections below keep them apart.

# ── Collections (Till) — used by registerC2BUrls.js ─────────────────────
# This is what registers the "someone paid the till directly" webhook, and
# is the same account "Add via M-Pesa" deposits already use in production.

# From developer.safaricom.co.ke -> My Apps -> your app (the one tied to
# your Till, not the Paybill)
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=

# Your Till number. Use Safaricom's shared sandbox shortcode 174379 while
# testing (that test shortcode is registered as a Paybill-type account on
# their side, so use MPESA_ACCOUNT_TYPE=paybill only while pointed at it —
# switch back to till once you put your real Till number here).
# Safaricom's C2B registration only accepts "your own" shortcode (the one
# your API credentials are tied to) — it rejects anything else with
# "Bad Request - Kindly use your own ShortCode".
MPESA_SHORTCODE=

# "till" for a Buy Goods Till number, "paybill" for a Paybill number —
# must match MPESA_SHORTCODE directly above. Kenokip Farm's collections
# account is a Till.
MPESA_ACCOUNT_TYPE=till

# "sandbox" while testing, "production" once your Till is live and you've
# been approved for the production Daraja app (see SETUP-MPESA.md).
MPESA_ENV=sandbox

# The base URL Firebase gives you after `firebase deploy --only functions`,
# e.g. https://us-central1-kenokip-farm.cloudfunctions.net
MPESA_CALLBACK_BASE_URL=

# The SAME value you set with:
#   firebase functions:secrets:set MPESA_WEBHOOK_SECRET
# (any long random string of your choosing — see SETUP-SECURITY.md). Putting
# it here too lets registerC2BUrls.js register your C2B URLs WITH that
# secret attached, e.g. .../c2bConfirmation/<this value>, so a stranger who
# finds these URLs on their own can't feed them fake payment data. Leave
# blank only if you haven't set that secret yet — everything still works,
# just without that extra protection until you do both steps.
MPESA_WEBHOOK_SECRET=

# ── Payouts (Paybill) — used by test-b2c.js / test-balance.js ───────────
# This is the account "Send via M-Pesa", "Check M-Pesa balance", and
# "Check transaction status" run against — see SETUP-B2C.md. Separate
# Daraja app credentials from the collections ones above, tied to the
# Paybill instead of the Till.

# From developer.safaricom.co.ke -> My Apps -> the app tied to the Paybill
MPESA_PAYOUT_CONSUMER_KEY=
MPESA_PAYOUT_CONSUMER_SECRET=

# Kenokip Farm's Paybill.
MPESA_PAYOUT_SHORTCODE=1307475
