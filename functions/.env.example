# Copy this to .env for local scripts (registerC2BUrls.js) ONLY.
# Never commit the real .env file — it's already git-ignored.
#
# The deployed Cloud Functions themselves read these as Secret Manager
# secrets, set with `firebase functions:secrets:set NAME` (see functions/README.md),
# not from this file — this file just lets registerC2BUrls.js run locally.

# From developer.safaricom.co.ke -> My Apps -> your app
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=

# Your Till/Paybill number. Use 174379 for Safaricom's shared sandbox
# Paybill while testing, then your real number once you're on production.
MPESA_SHORTCODE=

# From the same Daraja app page (Lipa Na M-Pesa Online passkey).
# Safaricom publishes a shared sandbox passkey in their docs for testing.
MPESA_PASSKEY=

# "till" for a Buy Goods Till number, "paybill" for a Paybill number.
# Safaricom rejects STK Push requests that use the wrong one for your
# shortcode, so this has to match what you actually have.
MPESA_ACCOUNT_TYPE=till

# "sandbox" while testing, "production" once your Till is live and you've
# been approved for the production Daraja app.
MPESA_ENV=sandbox

# The base URL Firebase gives you after `firebase deploy --only functions`,
# e.g. https://us-central1-kenokip-farm.cloudfunctions.net
MPESA_CALLBACK_BASE_URL=
