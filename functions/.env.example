# NOTE: none of the local scripts in this folder actually load a plain
# ".env" file — registerC2BUrls.js, test-b2c.js, and test-balance.js all
# read from "c2b.env" instead (see c2b.env.example), specifically so
# `firebase deploy` never auto-loads it as real Cloud Functions environment
# variables. This file is kept only as a secondary human-readable reference
# of the same collections (Till) values — edit c2b.env.example/c2b.env if
# you want a script to actually pick up a change.
#
# The deployed Cloud Functions themselves read the equivalent values as
# Secret Manager secrets, set with `firebase functions:secrets:set NAME`
# (see functions/README.md), not from either file.

# From developer.safaricom.co.ke -> My Apps -> your app (the one tied to
# your Till, not the Paybill — payouts use a separate app/credentials, see
# SETUP-B2C.md)
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=

# Your Till number. Use 174379 for Safaricom's shared sandbox Paybill-type
# test shortcode while testing, then your real Till number once you're on
# production.
MPESA_SHORTCODE=

# From the same Daraja app page (Lipa Na M-Pesa Online passkey).
# Safaricom publishes a shared sandbox passkey in their docs for testing.
MPESA_PASSKEY=

# "till" for a Buy Goods Till number, "paybill" for a Paybill number.
# Safaricom rejects STK Push requests that use the wrong one for your
# shortcode, so this has to match what you actually have. Kenokip Farm's
# collections account is a Till.
MPESA_ACCOUNT_TYPE=till

# "sandbox" while testing, "production" once your Till is live and you've
# been approved for the production Daraja app.
MPESA_ENV=sandbox

# The base URL Firebase gives you after `firebase deploy --only functions`,
# e.g. https://us-central1-kenokip-farm.cloudfunctions.net
MPESA_CALLBACK_BASE_URL=

# Payouts ("Send via M-Pesa") run against a completely separate account —
# Kenokip Farm's Paybill, 1307475 — with its own Consumer Key/Secret from
# its own Daraja app. See SETUP-B2C.md and c2b.env.example's MPESA_PAYOUT_*
# fields; there's nothing to add here for that.
