rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Which top-level fields of farms/kenokip each employee jobTitle may
    // change — mirrors the app's client-side sectionAllowed() exactly (see
    // index.html), just enforced here too so a restricted employee
    // genuinely cannot write that data, not just that the app hides the
    // button. This whole document is written as one piece every time
    // anything in it changes (see FARM_COLLECTION/.set(state) in
    // index.html) — that's fine: diff().affectedKeys() below still
    // correctly reports only the fields that actually changed VALUE,
    // regardless of how much of the document got resent in the same write.
    function jobAllowedFarmKeys(jobTitle) {
      // Supervisor and Farmhand both include 'expenses' here even though
      // neither can see the Expenses page (see sectionAllowed() in
      // index.html — that stays Financial-Staff-only) — logging a feed
      // entry with a cost auto-creates/updates a linked Expense record in
      // the SAME write as feedLogs (see the 'feed' branch of handleForm in
      // index.html), so without 'expenses' allowed here that combined
      // write was rejected outright and the feed entry never actually
      // saved whenever a price was included.
      return jobTitle == 'financial' ? ['expenses', 'incomes'] :
             jobTitle == 'supervisor' ? ['flock', 'broodings', 'eggs', 'eggLosses', 'feedLogs', 'healthRecords', 'customers', 'expenses'] :
             jobTitle == 'vet' ? ['healthRecords'] :
             jobTitle == 'farmhand' ? ['flock', 'broodings', 'eggs', 'eggLosses', 'feedLogs', 'expenses'] :
             [];
    }
    // 'settings' (currencies/categories/the About text) and 'version' (a
    // schema-migration counter) aren't restricted by job — every signed-in
    // account could already change these before roles existed, and nothing
    // about them is specific to one job.
    function farmWriteAllowed() {
      return request.auth.token.role == 'administrator' ||
        resource == null ||
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(jobAllowedFarmKeys(request.auth.token.jobTitle).concat(['settings', 'version']));
    }

    // Flock / Eggs / Expenses / Income / Settings — the general farm record.
    // Anyone can read it (including guests, with no account at all).
    // Writing requires a signed-in account, AND — for an employee — that
    // the fields actually being changed match their job (see
    // farmWriteAllowed() above; the administrator can change anything).
    // Before job-based restrictions existed, this was just
    // `allow write: if request.auth != null` — any signed-in account could
    // change any field. That's still exactly what happens for the
    // administrator, and for the 'settings'/'version' fields for everyone.
    match /farms/kenokip {
      allow read: if true;
      allow write: if request.auth != null && farmWriteAllowed();
    }

    // Finance — money. Only the administrator and Financial Staff can even
    // read it (this is what makes it fully invisible to everyone else,
    // including guests and other employees). Nothing may write here
    // directly, from anyone, ever — the only writes come from the
    // roles.js Cloud Functions (proposeFinanceEntry, reviewFinanceEntry,
    // editFinanceEntry, deleteFinanceEntry, setOpeningBalance), which run
    // with admin privileges and enforce the approval workflow in code.
    match /finance/kenokip {
      allow read: if request.auth != null &&
        (request.auth.token.role == 'administrator' ||
         (request.auth.token.role == 'employee' && request.auth.token.jobTitle == 'financial'));
      allow write: if false;
    }

    // Team accounts. Any signed-in account (administrator or employee) can
    // read the roster — this is what lets someone pick a team member to
    // message. Guests (not signed in at all) still can't see it. Only the
    // createStaffAccount / updateStaffAccount / deleteStaffAccount /
    // updateOwnProfile Cloud Functions may write here.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Access log (who signed in, when, from where). Administrator-only —
    // only the logAccess Cloud Function may write here.
    match /accessLogs/{id} {
      allow read: if request.auth != null && request.auth.token.role == 'administrator';
      allow write: if false;
    }

    // Team messaging. Administrator sees everything (oversight); anyone
    // else sees a message only if they sent it, it's addressed to them, or
    // it's a broadcast to everyone. Only the sendMessage / markMessageRead
    // Cloud Functions may write here — this is what stops anyone from
    // faking who a message is "from".
    match /messages/{id} {
      allow read: if request.auth != null &&
        (request.auth.token.role == 'administrator' ||
         resource.data.fromUid == request.auth.uid ||
         resource.data.toUid == request.auth.uid ||
         resource.data.toUid == 'all');
      allow write: if false;
    }

    // Internal bookkeeping for the one-time admin bootstrap. No client ever
    // needs to read or write this directly — only the bootstrapFirstAdmin
    // Cloud Function touches it (via the Admin SDK, which isn't subject to
    // these rules at all).
    match /meta/roles {
      allow read, write: if false;
    }

    // Authenticator-app (2FA) secrets. Nobody — not even the account owner
    // — reads or writes this directly from the client; only security.js's
    // Cloud Functions touch it via the Admin SDK. This is deliberately a
    // separate collection from `users/{uid}` (which any signed-in account
    // can read) so a TOTP secret can never leak out through that broader
    // rule — the only thing `users/{uid}` ever gets is a plain
    // `totpEnrolled` true/false flag, which reveals nothing useful.
    match /security/{uid} {
      allow read, write: if false;
    }

    // Finance security alerts (failed Finance-portal attempts, lockouts,
    // and the administrator clearing a lock). Same shape as accessLogs —
    // administrator-only, and only financeGuard.js's Cloud Functions may
    // write here.
    match /securityEvents/{id} {
      allow read: if request.auth != null && request.auth.token.role == 'administrator';
      allow write: if false;
    }

    // Receipt sign/verify audit trail (see receipts.js) — every receipt
    // ever generated, with exactly what it said and who generated it.
    // Administrator-only; only the signReceipt Cloud Function may write.
    match /receiptLog/{id} {
      allow read: if request.auth != null && request.auth.token.role == 'administrator';
      allow write: if false;
    }

    // Two-person receipt co-signing (a team member signs, the
    // administrator approves) — see requestReceiptSignoff /
    // approveReceiptSignoff / skipReceiptSignoff in roles.js, which are the
    // ONLY things that ever write here. That's deliberate: "only the
    // administrator can approve" and "a mandatory (withdrawal) request can
    // never be skipped" are enforced as plain server-side code in those
    // functions, not as Firestore rule expressions — simpler to reason
    // about, and (unlike a rules-language condition) directly testable
    // with ordinary Node tests. The request's own creator can read it (to
    // watch it go from pending to approved/skipped) and so can the
    // administrator (to see what's waiting on them); nobody else has any
    // reason to see a receipt someone else is in the middle of signing.
    match /pendingSignoffs/{id} {
      allow read: if request.auth != null &&
        (request.auth.token.role == 'administrator' || resource.data.createdBy == request.auth.uid);
      allow write: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
