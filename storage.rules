rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Team profile photos (Team Directory — see index.html/roles.js). Each
    // account can only ever write into its OWN folder here, named after its
    // own uid, which is exactly what updateOwnProfile checks server-side
    // before it will accept a photoURL — so nobody can end up pointing
    // their profile at an image they didn't upload themselves. Reading is
    // open to anyone (no `request.auth` check) because a profile photo
    // isn't sensitive and the app shows it inside an ordinary <img> tag —
    // gating reads would just mean broken images for a signed-out preview
    // or a shared link.
    match /profilePhotos/{uid}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Photo attachments on Health records and Expenses (see index.html —
    // attachPhotoTo()). recordId is that record's own id (already
    // unguessable — see uid() client-side), so the path itself isn't a
    // meaningful access boundary; real access control for who can even see
    // or add these records happens in the app (sectionAllowed) same as
    // every other farm record. Any signed-in team member can read or
    // write — there's no per-owner folder like profile photos above,
    // since these are shared farm records the whole team already sees.
    match /attachments/{recordType}/{recordId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }

    // Deny everything else by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
